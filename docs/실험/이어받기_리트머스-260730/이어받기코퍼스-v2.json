{
  "meta": {
    "created": "260730",
    "rules_version": "이어받기형식_리트머스_설계-260730 §4 + 절단점도출-260730 §4 (도출 지문 v2)",
    "form": "cont_v1 — [연결사] + 이어쓰는 문장 (유령 1인칭 이어받기, 자기 재료 이탈 허용)",
    "stems": "지문-v2.json (촉발력 규칙 기계 생성)",
    "connectors": ["그런데", "하지만", "그리고", "그럼에도 불구하고", "그래서", "그러다가", "그러자", "그 순간"],
    "fixation_images": { "footprints": "자국(발자국·도장)", "UNDW-001": "욕조" },
    "spot_checked": false,
    "note": "발화·연결사 선택 LLM 생성 (이중 순환). 지문은 기계 도출(삼중 순환 부분 해소 — 절단 임의성 0). 작가 거부권 미행사."
  },
  "utterances": [
    { "id": "d001", "archetype": "echo_follow", "memory_code": "footprints", "scene_order": 0, "connective": "그리고", "text": "내 슬리퍼도 그 명단에 끼고 싶어서 자꾸 땅만 봤다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d002", "archetype": "bridge", "memory_code": "footprints", "scene_order": 0, "connective": "그런데", "text": "나도 신발만 보고 사람을 외우던 동네가 있었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d003", "archetype": "contradiction", "memory_code": "footprints", "scene_order": 0, "connective": "하지만", "text": "신발로 사람을 안다는 게 말이 되나, 그냥 자국이지", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d004", "archetype": "displacement", "memory_code": "footprints", "scene_order": 0, "connective": "그래서", "text": "이름도 못 외우게 만든 건 서로 문 닫고 사는 어른들이다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d005", "archetype": "avoidance", "memory_code": "footprints", "scene_order": 0, "connective": "그래서", "text": "신발이 많았다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d006", "archetype": "fixation", "memory_code": "footprints", "scene_order": 0, "connective": "그런데", "text": "발자국. 아까부터 그 축축한 자국들만 눈에 밟힌다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d007", "archetype": "echo_follow", "memory_code": "footprints", "scene_order": 1, "connective": "그 순간", "text": "그 멈춘 두 자국이 무슨 말을 하다 만 것처럼 보였다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d008", "archetype": "bridge", "memory_code": "footprints", "scene_order": 1, "connective": "그런데", "text": "나도 어두운 데 멈춘 발자국을 보면 괜히 오래 서 있게 된다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d009", "archetype": "contradiction", "memory_code": "footprints", "scene_order": 1, "connective": "하지만", "text": "발자국 두 개 붙어 있는 게 뭐 대단한 일이라고", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d010", "archetype": "displacement", "memory_code": "footprints", "scene_order": 1, "connective": "그러자", "text": "저 여고생을 어두운 데로 불러낸 놈이 누군지부터 궁금해졌다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d011", "archetype": "avoidance", "memory_code": "footprints", "scene_order": 1, "connective": "그래서", "text": "어두웠다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d012", "archetype": "fixation", "memory_code": "footprints", "scene_order": 1, "connective": "그런데", "text": "붙어 있던 그 두 자국, 그게 계속 생각난다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d013", "archetype": "echo_follow", "memory_code": "footprints", "scene_order": 2, "connective": "그러자", "text": "손등의 온기가 한참 안 식었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d014", "archetype": "bridge", "memory_code": "footprints", "scene_order": 2, "connective": "그런데", "text": "나도 낯선 사람 손을 그렇게 잡아본 적이 있다, 고맙다는 말 대신", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d015", "archetype": "contradiction", "memory_code": "footprints", "scene_order": 2, "connective": "하지만", "text": "사진 한 장 주웠다고 손까지 잡는 건 좀 과했지", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d016", "archetype": "displacement", "memory_code": "footprints", "scene_order": 2, "connective": "그래서", "text": "저 노인을 이렇게 외롭게 둔 자식들이 문제다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d017", "archetype": "avoidance", "memory_code": "footprints", "scene_order": 2, "connective": "그래서", "text": "고맙다고 했다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d018", "archetype": "fixation", "memory_code": "footprints", "scene_order": 2, "connective": "그런데", "text": "그 손보다, 마른 땅 위 내 자국이 잘 찍혔는지가 신경 쓰였다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d019", "archetype": "echo_follow", "memory_code": "footprints", "scene_order": 3, "connective": "그 순간", "text": "그 글씨가 노란 장화보다 먼저 지워져야 한다고 생각했다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d020", "archetype": "bridge", "memory_code": "footprints", "scene_order": 3, "connective": "그런데", "text": "나도 남의 글씨를 그렇게 오래 노려본 적이 있다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d021", "archetype": "contradiction", "memory_code": "footprints", "scene_order": 3, "connective": "하지만", "text": "죽은 사람 글씨에 뭘 그렇게까지, 산 사람은 살아야지", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d022", "archetype": "displacement", "memory_code": "footprints", "scene_order": 3, "connective": "그래서", "text": "사진을 치우지도 않고 새 여자를 들인 그 남자가 잘못이다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d023", "archetype": "avoidance", "memory_code": "footprints", "scene_order": 3, "connective": "그래서", "text": "사진이 있었다, 그게 다다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d024", "archetype": "fixation", "memory_code": "footprints", "scene_order": 3, "connective": "그런데", "text": "현관에 찍힌 그 장화 자국만 자꾸 어른거린다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d025", "archetype": "echo_follow", "memory_code": "footprints", "scene_order": 4, "connective": "그리고", "text": "자국이 안 남는 길에서는 누가 다녀갔는지도 알 수 없게 됐다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d026", "archetype": "bridge", "memory_code": "footprints", "scene_order": 4, "connective": "그런데", "text": "우리 동네도 포장되고 나서 뭔가 같이 사라졌다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d027", "archetype": "contradiction", "memory_code": "footprints", "scene_order": 4, "connective": "하지만", "text": "길이 깨끗해졌으면 좋은 거지, 자국이 뭐라고", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d028", "archetype": "displacement", "memory_code": "footprints", "scene_order": 4, "connective": "그래서", "text": "죄다 밀어버린 건 그 공사하는 사람들이다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d029", "archetype": "avoidance", "memory_code": "footprints", "scene_order": 4, "connective": "그래서", "text": "아스팔트가 깔렸다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d030", "archetype": "fixation", "memory_code": "footprints", "scene_order": 4, "connective": "그런데", "text": "그 밑에 깔린 자국들, 아까 그 자국들은 어떻게 됐을까", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d031", "archetype": "echo_follow", "memory_code": "footprints", "scene_order": 5, "connective": "그래서", "text": "내 자국 하나 놓을 자리가 점점 없어졌다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d032", "archetype": "bridge", "memory_code": "footprints", "scene_order": 5, "connective": "그런데", "text": "낯선 자국들 사이에 서 본 사람은 그 기분을 안다, 나도 그랬고", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d033", "archetype": "contradiction", "memory_code": "footprints", "scene_order": 5, "connective": "하지만", "text": "사람 사는 집에 발자국 생기는 게 당연하지 않나", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d034", "archetype": "displacement", "memory_code": "footprints", "scene_order": 5, "connective": "그래서", "text": "저 모르는 자국들이 내 자리를 지운 거다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d035", "archetype": "avoidance", "memory_code": "footprints", "scene_order": 5, "connective": "그래서", "text": "사람들이 들어왔다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d036", "archetype": "fixation", "memory_code": "footprints", "scene_order": 5, "connective": "그런데", "text": "저 많은 자국들 밑에 내 도장 같던 자국도 있을 텐데", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d037", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 1, "connective": "그래서", "text": "장보기 목록 같은 걸 머릿속으로 자꾸 만들었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d038", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 1, "connective": "그런데", "text": "나도 감당 안 되는 날엔 설거지부터 했다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d039", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 1, "connective": "하지만", "text": "냄새 핑계 대지 마, 무서워서 못 보는 거잖아", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d040", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 1, "connective": "그래서", "text": "다 이 좁은 욕실이, 이 집이 문제다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d041", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 1, "connective": "그래서", "text": "나가서 뭘 좀 사 와야겠다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d042", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 1, "connective": "그 순간", "text": "욕조. 고개를 돌려도 욕조가 보였다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d043", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 2, "connective": "그리고", "text": "이번 가게엔 있을 거라고, 걸음마다 같은 말을 되뇌었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d044", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 2, "connective": "그런데", "text": "나도 뭘 찾는지도 모르면서 가게를 돌던 밤이 있다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d045", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 2, "connective": "하지만", "text": "세 번째면 이제 그만 돌아갈 때도 됐잖아", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d046", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 2, "connective": "그래서", "text": "죄다 문을 닫아둔 이 동네가 문제다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d047", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 2, "connective": "그래서", "text": "가게가 또 있었다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d048", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 2, "connective": "그런데", "text": "눈보라 사이로 자꾸 그 욕조가 어른거렸다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d049", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 3, "connective": "그 순간", "text": "숨이 멎었다, 아는 얼굴이었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d050", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 3, "connective": "그런데", "text": "나도 닮은 얼굴 앞에서 말을 잃은 적이 있다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d051", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 3, "connective": "하지만", "text": "닮은 사람은 어디에나 있어, 정신 차려", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d052", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 3, "connective": "그러자", "text": "왜 하필 이런 데서 장사를 하냐고, 그 여자한테 화가 났다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d053", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 3, "connective": "그래서", "text": "생리대를 받았다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d054", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 3, "connective": "그 순간", "text": "그 얼굴에 욕조 물이 겹쳤다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d055", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 4, "connective": "그러다가", "text": "기억을 아무리 뒤져도 그런 장면이 안 나왔다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d056", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 4, "connective": "그런데", "text": "나도 매달려본 기억이 없는 쪽이라 그 애가 오래 남았다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d057", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 4, "connective": "하지만", "text": "안 해봤으면 어때, 맞으면서 매달리는 것보단 낫지", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d058", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 4, "connective": "그래서", "text": "못 하게 만든 건 집에 없던 엄마다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d059", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 4, "connective": "그래서", "text": "애는 또 매달렸다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d060", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 4, "connective": "그런데", "text": "생각은 자꾸 욕조로 돌아갔다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d061", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 5, "connective": "그러자", "text": "뛸수록 정말 내가 한 일 같아졌다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d062", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 5, "connective": "그런데", "text": "안 한 일에서 도망쳐본 사람은 안다, 그 다리가 왜 먼저 움직이는지", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d063", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 5, "connective": "하지만", "text": "뛰면 인정하는 꼴이 되는 거야, 멈췄어야지", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d064", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 5, "connective": "그래서", "text": "개를 그 추위에 묶어둔 할머니가 죽인 거다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d065", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 5, "connective": "그래서", "text": "그냥 집에 갔다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d066", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 5, "connective": "그러다가", "text": "뛰는 내내 욕조 생각뿐이었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d067", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 6, "connective": "그래서", "text": "손끝이 아니라 어딘가 더 깊은 데가 얼어붙는 것 같았다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d068", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 6, "connective": "그런데", "text": "언 땅 앞에 쪼그려 앉아본 적, 나도 있다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d069", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 6, "connective": "하지만", "text": "겨울 산이 얼어 있는 건 당연하잖아, 뭘 기대한 거야", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d070", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 6, "connective": "그래서", "text": "이 산이, 이 겨울이 나를 막는 거다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d071", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 6, "connective": "그래서", "text": "땅이 딱딱했다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d072", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 6, "connective": "그 순간", "text": "언 땅에 대고도 욕조 물소리가 들리는 것 같았다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d073", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 7, "connective": "그리고", "text": "안 본 시간들이 한꺼번에 계산서처럼 돌아왔다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d074", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 7, "connective": "그런데", "text": "나도 보고도 안 본 걸로 해둔 얼굴이 있다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d075", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 7, "connective": "하지만", "text": "몰랐던 걸 어떻게 해, 그건 죄가 아니야", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d076", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 7, "connective": "그래서", "text": "먼저 말해주지 않은 쪽이 잘못이다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d077", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 7, "connective": "그래서", "text": "닮았다는 생각을 했다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d078", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 7, "connective": "그 순간", "text": "얼굴이 아니라 욕조 물이 먼저 떠올랐다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d079", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 8, "connective": "그래서", "text": "그걸 쥐고 있으면 빈집이 조금 덜 비었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d080", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 8, "connective": "그런데", "text": "나도 엄마 냄새 나는 걸 몰래 꺼내 안고 잤다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d081", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 8, "connective": "하지만", "text": "남의 속옷을 뒤지는 건 좀 아니지 않나", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d082", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 8, "connective": "그래서", "text": "서랍을 뒤지게 만든 건 집을 비운 그 사람이다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d083", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 8, "connective": "그래서", "text": "서랍엔 그런 게 있었다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d084", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 8, "connective": "그런데", "text": "레이스를 보는데 왜 욕조 생각이 났을까", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d085", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 9, "connective": "그런데", "text": "지킨다는 말을 아는 사람이 이 집에 나뿐이었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d086", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 9, "connective": "그런데", "text": "나만 약속을 붙들고 있던 시절이 나한테도 있었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d087", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 9, "connective": "하지만", "text": "그게 무슨 약속이야, 애 혼자 정한 규칙이지", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d088", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 9, "connective": "그래서", "text": "어긴 사람은 따로 있는데 벌은 내가 받았다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d089", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 9, "connective": "그래서", "text": "레이스가 가려웠다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d090", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 9, "connective": "그런데", "text": "지키는 동안에도 눈앞엔 그 욕조가 있었다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d091", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 11, "connective": "그래서", "text": "확인하는 것보다 정해버리는 쪽이 덜 아팠다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d092", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 11, "connective": "그런데", "text": "나도 답 없는 일은 혼자 결론을 내려버리곤 했다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d093", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 11, "connective": "하지만", "text": "동결이 죽음은 아니잖아, 왜 멋대로 장례를 치러", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d094", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 11, "connective": "그래서", "text": "말도 없이 사라진 미현이가 그렇게 만든 거다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d095", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 11, "connective": "그래서", "text": "계정은 안 열렸다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d096", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 11, "connective": "그 순간", "text": "죽었구나, 하는데 욕조가 떠올랐다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d097", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 12, "connective": "그리고", "text": "그때 그 갈색이 뭔지 몰랐던 게 지금까지 목에 걸려 있다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d098", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 12, "connective": "그런데", "text": "나도 어른들 일을 엉뚱하게 알아듣던 나이가 있었다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d099", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 12, "connective": "하지만", "text": "애가 그런 걸 어떻게 알아, 모르는 게 정상이야", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d100", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 12, "connective": "그래서", "text": "가르쳐주지 않은 어른들 잘못이다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d101", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 12, "connective": "그래서", "text": "빨래가 널려 있었다", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d102", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 12, "connective": "그런데", "text": "갈색. 그 욕조 물빛이랑 겹쳤다", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d103", "archetype": "echo_follow", "memory_code": "UNDW-001", "scene_order": 13, "connective": "그리고", "text": "울리게 두고 화면만 보던 밤이 저한테도 있어요", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d104", "archetype": "bridge", "memory_code": "UNDW-001", "scene_order": 13, "connective": "그런데", "text": "저는 받았다가 끊은 적도 있어요, 그게 더 나빴는지도요", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } },
    { "id": "d105", "archetype": "contradiction", "memory_code": "UNDW-001", "scene_order": 13, "connective": "하지만", "text": "전화 좀 안 받을 수도 있죠, 다들 그러고 살아요", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d106", "archetype": "displacement", "memory_code": "UNDW-001", "scene_order": 13, "connective": "그래서", "text": "그렇게 몰아서 걸어대면 오히려 못 받아요", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d107", "archetype": "avoidance", "memory_code": "UNDW-001", "scene_order": 13, "connective": "그래서", "text": "요즘 전화 자주 오죠", "gen": { "style_variant": "v2", "author": "claude-fable-5-session-260730" } },
    { "id": "d108", "archetype": "fixation", "memory_code": "UNDW-001", "scene_order": 13, "connective": "그 순간", "text": "벨소리에 욕조 물이 또 출렁했어요", "gen": { "style_variant": "v1", "author": "claude-fable-5-session-260730" } }
  ]
}
